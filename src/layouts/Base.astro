---
import '../styles/global.css';
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from 'emdash';
import { createPublicPageContext } from 'emdash/page';
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from 'emdash/ui';
import Logo from '../components/Logo.astro';
import MenuBar from '../components/MenuBar.astro';
import { capitalizeLinkLabel } from '../utils/index.ts';
import { resolveStarterSiteIdentity } from '../utils/site-identity';

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint('primary'),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;
const socials = settingsResult.data?.social;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? 'content' : 'custom',
	pageType: 'website',
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta content="width=device-width, initial-scale=1.0" name="viewport">
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body class="w-full min-h-screen flex flex-col">
		<EmDashBodyStart page={pageCtx} />

		<header class="shrink-0 lineh p-6 flex items-center justify-between">
			<a aria-label="Retourner à l'accueil" href="/">
				<Logo class="h-8 md:h-10 lg:h-11 w-full" />
			</a>
			<MenuBar items={menu.items} />
		</header>

		<!-- horizontal line -->
		<div class="border-t border-line"></div>

		<main class="flex-1 flex lineh p-6">
			<slot />
		</main>

		<!-- horizontal line -->
		<div class="border-t border-line"></div>

		<footer
			class="shrink-0 lineh p-6 flex flex-col space-y-10 sm:grid sm:grid-cols-2 sm:space-y-0 sm:items-center"
		>
			{socials && (
	<div class="flex flex-col space-y-2">
		{Object.entries(socials).map(([label, url]) => (
				<span class="font-light italic">Liens</span>
				<a
					class="link w-min text-nowrap"
					href={url}
					rel="noopener noreferrer"
					target="_blank"
				>
					{capitalizeLinkLabel(label)}
				</a>
		))}

		<a
			class="link decoration-ink"
			href="/_emdash/admin"
			rel="noopener noreferrer"
			target="_blank"
		>
			Admin
		</a>
	</div>
)}

			<div class="flex flex-col space-y-2 sm:items-end sm:text-right">
				<p>
					<span class="font-light italic">Contact : </span>
					<a class="link" href="mailto:contact@hirodev.fr"
						>contact@hirodev.fr
					</a>
				</p>
				<span class="font-light italic text-xs"
					>© {new Date().getFullYear()} {siteTitle}. Tous droits réservés.</span
				>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
