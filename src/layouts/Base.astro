---
import '../styles/global.css';
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from 'emdash';
import { createPublicPageContext } from 'emdash/page';
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from 'emdash/ui';
import { resolveStarterSiteIdentity } from '../utils/site-identity';

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint('primary'),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;
const socials = settingsResult.data?.social;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? 'content' : 'custom',
	pageType: 'website',
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta content="width=device-width, initial-scale=1.0" name="viewport">
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body class="w-full min-h-screen flex flex-col">
		<EmDashBodyStart page={pageCtx} />

		<header class="h-[12vh] lineh p-6 flex items-center justify-between">
			<a aria-label="Retourner à l'accueil" href="/">
				{siteLogo ? (
	<img
		alt={siteLogo.alt || siteTitle}
		class="h-12 w-full mx-3"
		src={siteLogo.url}
	/>
) : (
	<span class="text-xl">{siteTitle}</span>
)}
			</a>
			<nav class="flex gap-4">
				{menu?.items.map((item) => (
	<a
		class="link"
		href={item.url}
		rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
		target={item.target}
	>
		{item.label}
	</a>
))}
			</nav>
		</header>

		<!-- horizontal line -->
		<div class="border-t border-line"></div>

		<main class="lineh p-6 min-h-[70vh]">
			<slot />
		</main>

		<!-- horizontal line -->
		<div class="border-t border-line"></div>

		<footer class="h-[18vh] lineh p-6 flex items-center justify-between">
			{socials && (
		<span>Liens</span>
		<div class="flex gap-4">
			{Object.entries(socials).map(([label, url]) => (
				<a class="link" href={url} rel="noopener noreferrer" target="_blank">
					{label}
				</a>
			))}
		</div>
)}
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
