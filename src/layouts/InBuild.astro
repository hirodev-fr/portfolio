---
import { getSiteSettings, getEmDashCollection } from 'emdash';
import { EmDashHead } from 'emdash/ui';
import { createPublicPageContext } from 'emdash/page';
import Logo from '../components/Logo.astro';
import { sortCollectionByIndex } from '../utils'
import { Font } from 'astro:assets';
import { ALLOW_POLICIES_IN_BUILD } from 'astro:env/client';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image, type = 'website' } = Astro.props;
const settings = await getSiteSettings();
const siteTitle =
  settings?.title || import.meta.env.ASTRO_APP_NAME || 'HIRO DEV';
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription = settings?.tagline || '';

const pageCtx = createPublicPageContext({
  Astro,
  kind: 'custom',
  pageType: type,
  title: fullTitle,
  pageTitle: title ?? siteTitle,
  description: description || siteDescription,
  canonical: Astro.url.href,
  image,
  seo: { ogImage: image },
  siteName: siteTitle,
});

const policies = ALLOW_POLICIES_IN_BUILD
  ? await getEmDashCollection('policies')
  : null;

if (policies && Astro.cache?.enabled) Astro.cache.set(policies.cacheHint);

const sortedPolicies = policies ? sortCollectionByIndex(policies, 'ascendant') : null
---

<!doctype html>
<html lang='fr'>
  <head>
    <meta charset='utf-8' />
    <link rel='icon' type='image/x-icon' href='/favicon.ico' />
    <link rel='icon' type='image/png' sizes='32x32' href='/icons/icon-32.png' />
    <link rel='icon' type='image/png' sizes='16x16' href='/icons/icon-16.png' />
    <link rel='apple-touch-icon' sizes='180x180' href='/icons/icon-180.png' />
    <link rel='manifest' href='/site.webmanifest' />
    <meta name='theme-color' content='#dd3d3f' />
    <link rel='sitemap' href='/sitemap-index.xml' />
    <meta name='viewport' content='width=device-width' />
    <meta name='generator' content={Astro.generator} />
    <meta name='robots' content='noindex, nofollow' />
    <title>{fullTitle}</title>
    <EmDashHead page={pageCtx} />
    <Font cssVariable='--font-display' preload />
    <Font cssVariable='--font-mono' preload />
  </head>
  <body class='w-full min-h-screen flex flex-col'>
    <div class='px-4 md:px-11 border-b-line border-b h-16 md:h-22'>
      <header class='border-x-line border-x h-full flex items-center px-4'>
        <a href='/' aria-label="Retour à l'accueil">
          <Logo class='h-6 md:h-10 w-auto' />
        </a>
      </header>
    </div>
    <main
      class='min-h-[70vh] px-6 mx-4 md:mx-11 border-x-line border-x h-full flex-1 flex flex-col'
    >
      <slot />
    </main>
    <footer class='px-4 md:px-11 w-full border-t border-t-line'>
      <div
        class='border-x-line border-x w-full py-10 px-4 sm:px-6 md:px-14 lg:px-20 flex flex-col md:flex-row justify-center md:justify-between space-y-10 md:space-y-0 text-xs md:text-sm font-mono font-light'
      >
        <div class='flex flex-col justify-center space-y-3'>
          {
            sortedPolicies &&
              sortedPolicies.entries.map((policy) => (
                <p>
                  <a
                    href={`/policies/${policy.data.slug}`}
                    class='underline decoration-primary'
                  >
                    {policy.data.title}
                  </a>
                </p>
              ))
          }
          <p>
            <a
              href='/_emdash/admin/'
              target='_blank'
              rel='noopener noreferrer'
              class='underline'>Admin</a
            >
          </p>
        </div>
        <div class='flex flex-col space-y-3 md:self-end'>
          <p>
            Contact : <a
              href='mailto:contact@hirodev.fr'
              class='underline decoration-primary'>contact@hirodev.fr</a>
          </p>
          <p>© {new Date().getFullYear()} {siteTitle}. Tous droits réservés.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
