---
import type { MenuItem } from 'emdash';
import { safeUrl } from '../utils/safe-url';

interface Props {
	items: MenuItem[];
}

const { items } = Astro.props;
const links = items.flatMap((item) => {
	const url = safeUrl(item.url);
	return url ? [{ ...item, url }] : [];
});
---

<nav class="hidden md:flex gap-4">
	{links.map((item) => (
	<a
		class="link"
		href={item.url}
		rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
		target={item.target}
	>
		{item.label}
	</a>
))}
</nav>

<button
	class="md:hidden btn btn-ghost font-normal border border-ink"
	id="open-menu"
	type="button"
>
	Menu
</button>
<dialog class="modal" id="menu_modal">
	<div
		class="modal-box flex flex-col items-center shadow-none border border-ink"
	>
		<nav class="flex flex-col gap-4 my-4 items-center text-lg">
			{links.map((item) => (
	<a
		class="link"
		href={item.url}
		rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
		target={item.target}
	>
		{item.label}
	</a>
))}
		</nav>
		<p class="mt-10 text-xs font-light italic text-center">
			Vous pouvez fermer ce menu en cliquant n'importe où en dehors.
		</p>
	</div>
	<form class="modal-backdrop bg-base/70" method="dialog">
		<button type="submit">Fermer le menu</button>
	</form>
</dialog>

<script>
document.getElementById('open-menu')?.addEventListener('click', () => {
	(
		document.getElementById('menu_modal') as HTMLDialogElement | null
	)?.showModal();
});
</script>
