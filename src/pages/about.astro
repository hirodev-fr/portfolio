---
import { getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import BaseLayout from '../layouts/Base.astro';

const { entry: page, cacheHint } = await getEmDashEntry('pages', 'about');

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<BaseLayout title='À propos' description='En savoir plus sur qui nous sommes et ce que nous faisons.'>
  <div class='flex flex-col flex-1 py-9 px-4 sm:px-6 md:px-14 lg:pl-20 space-y-10'>
    <header>
      <h1 class='uppercase text-4xl sm:text-5xl md:text-6xl' {...page?.edit?.title}>
        {page?.data?.title || 'À propos'}
      </h1>
    </header>

    <div class='grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-14'>
      <!-- Main Content Column -->
      <div
        class='lg:col-span-2 flex flex-col space-y-5 text-sm sm:text-base leading-relaxed
        [&_p]:mb-6
        [&_h2]:pt-8 [&_h2]:text-2xl [&_h2]:uppercase [&_h2]:font-bold [&_h2]:mb-4
        [&_h3]:pt-6 [&_h3]:text-xl [&_h3]:uppercase [&_h3]:font-bold [&_h3]:mb-3
        [&_ul]:list-disc [&_ul]:list-inside [&_ul]:mb-6 [&_ul]:space-y-2
        [&_ol]:list-decimal [&_ol]:list-inside [&_ol]:mb-6 [&_ol]:space-y-2
        [&_a]:underline [&_a]:decoration-primary [&_a]:text-accent hover:[&_a]:text-accent/80'
        {...page?.edit?.content}
      >
        {
          page && page?.data?.content ? (
            <PortableText value={page.data.content} />
          ) : (
            <p>Contenu en cours de rédaction.</p>
          )
        }
      </div>

      <!-- Sidebar Column -->
      <aside class='lg:col-span-1 flex flex-col sm:flex-row lg:flex-col gap-10 lg:sticky lg:top-10 h-fit border-t border-t-line pt-10 sm:pt-0 sm:border-t-0 lg:border-t lg:pt-10'>
        <div class='flex-1 space-y-4'>
          <h3 class='font-display font-bold uppercase text-lg'>Services</h3>
          <ul class='list-none space-y-2 font-mono text-xs sm:text-sm text-ink-light'>
            <li>Identité de marque</li>
            <li>Design & Développement Web</li>
            <li>Design Graphique</li>
            <li>Direction Artistique</li>
          </ul>
        </div>

        <div class='flex-1 space-y-4'>
          <h3 class='font-display font-bold uppercase text-lg'>Contact</h3>
          <p class='font-mono text-xs sm:text-sm text-ink-light'>
            <a href='mailto:contact@hirodev.fr' class='underline hover:text-primary transition-colors'>
              contact@hirodev.fr
            </a>
          </p>
          <p class='font-mono text-xs sm:text-sm text-ink-light'>
            <a href='/contact' class='underline hover:text-primary transition-colors'>
              Nous envoyer un message →
            </a>
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
