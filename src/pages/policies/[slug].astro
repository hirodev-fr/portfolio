---
import { getEmDashEntry, decodeSlug } from 'emdash';
import { PortableText } from 'emdash/ui';
import BaseLayout from '../../layouts/Base.astro';
import InBuildLayout from '../../layouts/InBuild.astro';
import { IN_BUILD } from 'astro:env/client';

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
  return Astro.redirect('/404');
}

const { entry: policy, cacheHint } = await getEmDashEntry('policies', slug);

if (!policy) {
  return Astro.redirect('/404');
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const rawDate = policy.data.updatedAt || policy.data.createdAt;

const formattedDate = new Date(rawDate).toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const Layout = IN_BUILD ? InBuildLayout : BaseLayout;
---

<Layout>
  <div class='flex flex-col space-y-5 flex-1 py-9 px-4 sm:px-6 md:px-14'>
    <h1 class='uppercase text-xl' {...policy.edit?.title}>
      {policy.data.title}
    </h1>

    {
      formattedDate && (
        <h2 class='font-light text-accent/80 text-sm uppercase'>
          Dernière mise à jour : {formattedDate}
        </h2>
      )
    }

    <div
      class='flex flex-col space-y-5
			[&_p]:leading-relaxed
			[&_h3]:pt-8 [&_h3]:text-lg [&_h3]:uppercase [&_h3]:font-medium
			[&_ul]:list-disc [&_ul]:list-inside [&_ul]:mt-2 [&_ul]:space-y-1
			[&_ol]:list-decimal [&_ol]:list-inside [&_ol]:mt-2 [&_ol]:space-y-1
			[&_a]:underline [&_a]:decoration-primary [&_a]:text-accent hover:[&_a]:text-accent/80'
      {...policy.edit?.content}
    >
      <PortableText value={policy.data.content} />
    </div>
  </div>
</Layout>
