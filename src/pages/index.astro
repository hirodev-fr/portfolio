---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base>
  <div
    class='flex flex-col justify-center flex-1 min-h-screen px-4 sm:px-6 md:px-14 lg:pl-20'
  >
    <h1 class='uppercase text-4xl sm:text-5xl md:text-6xl mb-10'>
      Le développement web, à la lyonnaise.
    </h1>
    <p class='w-full md:w-3/4 lg:w-2/3 text-md sm:text-lg mg:text-xl'>
      Nous proposons des solutions web modernes, adaptées à vos besoins.
    </p>
    <p class='w-full md:w-3/4 lg:w-2/3 text-md sm:text-lg mg:text-xl'>
      Notre seul objectif : contribuer à la réussite de votre projet.
    </p>
    <Button
      as='a'
      href='/contact'
      class='mt-8 w-full sm:w-1/2 md:w-1/3 lg:w-1/4'
    >
      Prendre contact
    </Button>
  </div>
</Base>
