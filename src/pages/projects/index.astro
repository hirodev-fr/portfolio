---
import Base from '../../layouts/Base.astro';
import ProjectSort from '../../components/ProjectSort.tsx';
import ProjectList from '../../components/ProjectList.tsx';
import { getEmDashCollection } from 'emdash';

const projects = await getEmDashCollection('projects');

const map = Object.values(projects.entries).map((value) => value.data);
---

<Base>
	<div class="flex flex-col flex-1">
		<div class="flex flex-col space-y-4 lg:space-y-0 lg:flex-row lg:items-center w-full border-b-line border-b py-9 px-4 sm:px-10 md:px-14">
			<h1 class="uppercase text-4xl sm:text-5xl md:text-6xl">Nos réalisations.</h1>
			<div class="lg:ml-auto flex lg:justify-end items-center space-x-3 h-full w-full md:max-w-1/2 relative">
				<ProjectSort client:load />
			</div>
		</div>

		<div class="flex flex-col flex-1 py-9 px-4 sm:px-10 md:px-14">
			<ProjectList projects={map} client:load />
		</div>
	</div>
</Base>
