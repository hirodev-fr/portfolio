---
import InBuildLayout from '../layouts/InBuild.astro';

Astro.response.status = 503;
Astro.response.statusText = 'Service Unavailable';
Astro.response.headers.set('Retry-After', '3600');
---

<InBuildLayout>
  <div
    class='place-self-center flex-1 flex flex-col items-center justify-center space-y-5 py-auto'
  >
    <h1 class='text-4xl sm:text-5xl lg:text-6xl'>Site en construction.</h1>
    <h2 class='text-md md:text-lg lg:text-xl'>
      Nous avons hâte de pouvoir vous présenter notre travail.
    </h2>
  </div>
</InBuildLayout>
